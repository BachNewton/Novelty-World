+  const rows: number[] = [];
+  const indices = [...wood.indices];
+  // The wood as `crownWood` lays it, two rows a vertex, with the last two rows of a piece of wood.
+  for (let at = 0; at < wood.rows.length; at += ROWS_A_VERTEX * 4) rows.push(...wood.rows.slice(at, at + ROWS_A_VERTEX * 4), 0, 0, 0, 0, 0, 0, 0, PINE_WOOD);
+  const vertex = (point: CrownPoint, height: V3, thin: number, crown: V3, along: number, across: number, shows: number, kind: number) => {
+    rows.push(point[0], point[1], point[2], PART_WOOD, height[0], height[1], height[2], thin, crown[0], crown[1], crown[2], 0, along, across, shows, kind);
+    return rows.length / (PINE_ROWS * 4) - 1;
+  };
+  const quad = (corners: number[]) => indices.push(corners[0], corners[1], corners[2], corners[0], corners[2], corners[3]);
+
+  SPRAYS.forEach(([angle, out, ring, grown], spray) => {
+    const middle = outAt(angle, out, ring);
+    SPRAY_CARDS.forEach(([turn, tilt, roll], card) => {
+      const wobble = (rolled(spray, 10 + card) - 0.5) * 0.5;
+      const { way, side } = cardFrame(angle + turn + wobble, tilt + wobble * 0.4, roll);
+      const corners = cardCorners(add([0, 0, 0], way, -CARD_LONG * CARD_BACK), way, side, CARD_LONG, CARD_WIDE);
+      quad(corners.map(([crown, along, across]) => vertex(middle, [0, 0, 0], 0, crown, along, across, grown, PINE_CROWN_CARD)));
+    });
+  });
+
+  WHORLS.forEach((ring, whorl) => {
+    const low = whorl / (WHORLS.length - 1);
+    const length = WHORL_LENGTH[0] + (WHORL_LENGTH[1] - WHORL_LENGTH[0]) * low;
+    const start: CrownPoint = [0, ring, 0];
+    for (let limb = 0; limb < WHORL_LIMBS; limb++) {
+      const angle = (limb / WHORL_LIMBS) * 2 * Math.PI + whorl * 1.9 + (rolled(whorl, 30 + limb) - 0.5) * 0.8;
+      const way = norm([Math.sin(angle), WHORL_RISE, Math.cos(angle)]);
+      const side: V3 = norm(crossOf(way, [0, 1, 0]));
+      const over = crossOf(side, way);
+      const base = Array.from({ length: LIMB_SIDES }, (_, at) => {
+        const turn = (at / LIMB_SIDES) * 2 * Math.PI;
+        const ringOut: V3 = [0, 1, 2].map((axis) => (side[axis] * Math.cos(turn) + over[axis] * Math.sin(turn)) * WHORL_RADIUS) as V3;
+        return vertex(start, ringOut, 0.3, [0, 0, 0], 0, 0, low, PINE_WHORL_WOOD);
+      });
+      const tip = vertex(start, add([0, 0, 0], way, length), 0.9, [0, 0, 0], 0, 0, low, PINE_WHORL_WOOD);
+      for (let at = 0; at < LIMB_SIDES; at++) indices.push(base[at], base[(at + 1) % LIMB_SIDES], tip);
+      const roll = (rolled(whorl, 40 + limb) - 0.5) * 1.2;
+      const cardSide: V3 = [0, 1, 2].map((axis) => side[axis] * Math.cos(roll) + over[axis] * Math.sin(roll)) as V3;
+      const corners = cardCorners(add([0, 0, 0], way, length * 0.3), way, cardSide, length * WHORL_CARD_LONG, length * WHORL_CARD_WIDE);
+      quad(corners.map(([height, along, across]) => vertex(start, height, 0, [0, 0, 0], along, across, low, PINE_WHORL_CARD)));
+    }
+  });
+  return { table: Float32Array.from(rows), vertices: rows.length / (PINE_ROWS * 4), indices };
+}
+
+export const PINE = pineOf();
