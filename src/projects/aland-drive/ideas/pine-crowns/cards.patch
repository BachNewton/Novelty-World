+import { crownWood, grownOutline, outAt, PART_WOOD, rolled, ROWS_A_VERTEX, type CrownPoint } from "./bare-tree";
+
+/*
+ * A Scots pine near the camera, as numbers, for the forest's pine list (`forest.ts`). A pine's crown is needles you can
+ * see through, so it is drawn as games draw one: a bare trunk forking near the top into a few short limbs, its crown a
+ * cloud of flat cards each standing for a spray of needles on its twig, and whorls of short limbs further down the
+ * trunk with a spray at each limb's end. The forest's shader cuts each card's needles out of it (`pineNeedles`,
+ * `forest.ts`), so the limbs and the sky show through the crown.
+ *
+ * Every point is laid as a bare broadleaf's are (`bare-tree.ts`), in the crown's own terms: how far up the outline
+ * table's rings and what share of the crown's width there, so one set fits every stage of a pine's life. On top of
+ * that a point carries an offset in the tree's own height (a limb's length and thickness, a whorl card's spread) and
+ * one in the crown's width where it sits (a crown card's spread), so a card is the same spray however close a crown's
+ * rings stand.
+ *
+ * A young pine grows its crown's sprays in one by one, carrying half of them, from one model: a spray not yet grown is
+ * drawn in to its middle. Its whorls reach further down the more open it stands, the younger it is and on rock; in a
+ * dense wood the lower ones are dead stubs with no needles.
+ */
+
+/** A vertex is four rows of four floats: (crown point, part), (offset in the tree's height, how thin), (offset in the crown's width, 0), (card's along, card's across, when it shows, its kind). */
+export const PINE_ROWS = 4;
+/** What a vertex is, in its last row: wood, a crown's card, a whorl's limb, a whorl's card. */
+export const PINE_WOOD = 0;
+export const PINE_CROWN_CARD = 1;
+export const PINE_WHORL_WOOD = 2;
+export const PINE_WHORL_CARD = 3;
+
+/** The leader up the middle, ring and radius as a share of height, and the short limbs it forks into at its top: where each leaves it, which way and how far out. */
+const LEADER: [ring: number, radius: number][] = [[6.2, 0]];
+const FORKS: [from: number, angle: number, out: number, to: number][] = [
+  [5.4, 1.5, 0.4, 6.2],
+  [5.6, 4.2, 0.38, 6.3],
+];
+const FORK_RADIUS = 0.006;
+const LIMB_SIDES = 3;
+
+/**
+ * The crown's sprays: their middle (way round, share of the crown's width out, ring), and the stage of life each has
+ * grown in by (0 young, 1 grown). Packed close in height and round, so their cards overlap into one cloud.
+ */
+const SPRAYS: [angle: number, out: number, ring: number, grown: number][] = [
+  [0, 0.05, 7.1, 0],
+  [0.6, 0.55, 6.6, 0],
+  [3.4, 0.58, 6.4, 0],
+  [2, 0.62, 6.9, 0.55],
+  [4.9, 0.6, 5.9, 0.25],
+  [1.3, 0.66, 5.6, 0.8],
+];
+/** How long a spray takes to grow in, in stages. */
+export const SPRAY_GROWS = 0.35;
+/** Each spray's cards: their way round from the spray's own, how far they tilt up and roll about their own length, in radians; their length and width as shares of the crown's width. */
+const SPRAY_CARDS: [turn: number, tilt: number, roll: number][] = [
+  [0, 0.3, 0.2],
+  [1.5, 0.15, 1.1],
+  [-1.5, 0.45, -0.7],
+  [3.1, 0.25, 0.5],
+];
+const CARD_LONG = 1.45;
+const CARD_WIDE = 1.25;
+/** Where along a card its twig starts, as a share of its length behind the spray's middle. */
+const CARD_BACK = 0.3;
+
+/** The whorls down the trunk: their ring, highest first, and how far down the tree it is (0 the highest, 1 the lowest), which says when it shows. */
+const WHORLS = [4.6, 3.4, 2.2, 1.3, 0.6];
+const WHORL_LIMBS = 3;
+/** A whorl's limb: its length as a share of the tree's height, how much it rises for its length, its radius at the trunk; its card's length and width as shares of the limb's. */
+const WHORL_LENGTH: [highest: number, lowest: number] = [0.1, 0.14];
+const WHORL_RISE = 0.35;
+const WHORL_RADIUS = 0.005;
+const WHORL_CARD_LONG = 0.95;
+const WHORL_CARD_WIDE = 1.0;
+
+type V3 = [number, number, number];
+const add = (a: V3, b: V3, by = 1): V3 => [a[0] + b[0] * by, a[1] + b[1] * by, a[2] + b[2] * by];
+const norm = (a: V3): V3 => {
+  const length = Math.hypot(...a);
+  return [a[0] / length, a[1] / length, a[2] / length];
+};
+const crossOf = (a: V3, b: V3): V3 => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+
+/** A card's corners from its twig's start along a way, with a side square to it: (offset, along, across) for each, in the order its two triangles read. */
+function cardCorners(start: V3, way: V3, side: V3, long: number, wide: number) {
+  const tip = add(start, way, long);
+  return [
+    [add(start, side, -wide / 2), 0, -1],
+    [add(start, side, wide / 2), 0, 1],
+    [add(tip, side, wide / 2), 1, 1],
+    [add(tip, side, -wide / 2), 1, -1],
+  ] as [V3, number, number][];
+}
+
+/** A card's way and side: out along `turn` (radians round the tree), tilted up by `tilt`, rolled about its length by `roll`. */
+function cardFrame(turn: number, tilt: number, roll: number) {
+  const way = norm([Math.sin(turn) * Math.cos(tilt), Math.sin(tilt), Math.cos(turn) * Math.cos(tilt)]);
+  const flat: V3 = [Math.cos(turn), 0, -Math.sin(turn)];
+  const over = crossOf(way, flat);
+  const side: V3 = [0, 1, 2].map((axis) => flat[axis] * Math.cos(roll) + over[axis] * Math.sin(roll)) as V3;
+  return { way, side };
+}
+
+export interface PineModel {
+  /** Every vertex's `PINE_ROWS` vec4s. */
+  table: Float32Array;
+  vertices: number;
+  indices: number[];
+}
+
+function pineOf(): PineModel {
+  const wood = crownWood(grownOutline("pine"));
+  wood.trunk();
+  wood.leader(LEADER);
+  for (const [from, angle, out, to] of FORKS) wood.branch([outAt(angle, 0, from), outAt(angle, out, to)], [FORK_RADIUS, 0], LIMB_SIDES, PART_WOOD, [0.3, 0.8]);
