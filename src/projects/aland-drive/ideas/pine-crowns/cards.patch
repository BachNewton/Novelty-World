+import { BufferAttribute, BufferGeometry } from "three";
+import { describe, expect, it } from "vitest";
+import { coplanarOverlaps } from "../art/coplanar";
+import { PINE, PINE_ROWS } from "./pine-tree";
+import { NEAR_RINGS, shapeRows, STAGES, TREE_KINDS } from "./tree-shapes";
+
+const VALUES = PINE_ROWS * 4;
+const vertices = Array.from({ length: PINE.vertices }, (_, at) => PINE.table.subarray(at * VALUES, (at + 1) * VALUES));
+
+/** The pine laid on one row of the outline table as the forest's shader lays it, at a height of 20 m, grown, every whorl showing, with no roll. */
+function laidOn(rings: readonly [number, number][]): BufferGeometry {
+  const positions = vertices.flatMap(([x, ring, z, , heightX, heightY, heightZ, , crownX, crownY, crownZ]) => {
+    const lower = Math.min(Math.max(Math.floor(ring), 0), NEAR_RINGS - 2);
+    const t = ring - lower;
+    const up = rings[lower][0] + (rings[lower + 1][0] - rings[lower][0]) * t;
+    const wide = rings[lower][1] + (rings[lower + 1][1] - rings[lower][1]) * t;
+    // A crown card's spread is in the crown's width at its ring, as the shader reads it.
+    const crownWide = rings[Math.floor(ring)][1];
+    return [(x * wide + heightX + crownX * crownWide) * 20, (up + heightY + crownY * crownWide) * 20, (z * wide + heightZ + crownZ * crownWide) * 20];
+  });
+  const geometry = new BufferGeometry();
+  geometry.setAttribute("position", new BufferAttribute(Float32Array.from(positions), 3));
+  geometry.setIndex(PINE.indices);
+  return geometry;
+}
+
+describe("a pine near the camera", () => {
+  // A ring past the table's last reads another tree's row.
+  it("lays every point within the outline table's rings", () => {
+    for (const [, ring] of vertices) {
+      expect(ring).toBeGreaterThanOrEqual(0);
+      expect(ring).toBeLessThanOrEqual(NEAR_RINGS - 1);
+    }
+  });
+
+  it("has no two faces in one plane at any stage of its life, nor on rock", () => {
+    const pine = TREE_KINDS.indexOf("pine") * STAGES;
+    const rows = [...shapeRows().slice(pine, pine + STAGES), shapeRows().at(-1) ?? []];
+    for (const rings of rows) expect(coplanarOverlaps(laidOn(rings))).toEqual([]);
+  });
+});
