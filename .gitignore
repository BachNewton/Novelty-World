/node_modules
/.pnp
.pnp.*
__pnp.*

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# claude code
.claude/*
!.claude/skills/
!.claude/commands/

# opencode agent worktrees
.opencode/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli cache
supabase/.temp/
supabase/.branches/

# finland catalogue audiobook generator
scripts/.audiobook-cache/
audiobook-gen*.log
finland-catalogue-audiobook*.mp3
src/projects/monopoly/bots/optimize/best-vector.json
# ES / gauntlet / ratings run logs (regenerable artifacts, not source)
src/projects/monopoly/bots/optimize/*.log

# Shipwright debug screenshots (scripts/shipwright-shots.mjs)
**/.shots/

# Shipwright render-cost benchmark results (src/projects/shipwright/tools/bench.mjs)
**/.bench/

# Isolated dist dir for the Shipwright perf sweep's production server (see next.config.ts distDir)
.next-bench/

# Each e2e run's own build, one folder per run (e2e/next-server.ts deletes finished runs' folders)
.next-e2e/

# learned-bot (RL) training checkpoints — generated net weights + meta
rl-checkpoints/

# Python bytecode cache (regenerates automatically; never commit)
__pycache__/

# family tree genealogy research (living people, public repo)
/src/projects/family-tree/research/

# the repo's Python venv, used by the family tree layout solver (npm run setup:family-tree-solver)
/.venv/

# Monopoly AI scenario runs (full call records; the scoreboards are committed)
/src/projects/monopoly/bots/ai/eval/runs/

# The relay bundle relay/deploy.sh builds
.relay-dist/

# Risk position recordings (npm run risk:record): data for fitting an evaluation, regenerable from their seeds
/src/projects/risk/eval/positions/

# Risk native port: Cargo build output (src/projects/risk/native/)
**/native/target/

# Risk GPU engine: the large blitz tables are regenerated locally (`npm run risk:gpu-tables`), only
# the small bound is committed; GPU runs' outputs stay local
/src/projects/risk/gpu/data/blitz-*
!/src/projects/risk/gpu/data/blitz-32*
/src/projects/risk/gpu/runs/

# audiobook drama renders (regenerable from the scripts and locked voices)
src/projects/audiobook/drama/**/audio/
src/projects/audiobook/drama/**/book/*.mp3
**/__pycache__/
